/* Advanced tab */
"advanced.intro" = "Scrolling can follow your hand instead of staying fixed. Pick a mode, then tune the coefficients - they apply from the next drag, so you can try a value without restarting anything.";
"advanced.speedMode" = "Speed mode:";
"advanced.speedMode.title" = "Speed mode";
"mode.constant.title" = "Constant";
"mode.velocity.title" = "Follow the hand";
"mode.distance.title" = "Progressive";
"mode.constant.explanation" = "One multiplier, as before.";
"mode.velocity.explanation" = "Faster hand, further scroll; accelerating adds a boost.";
"mode.distance.explanation" = "The further you drag from the start, the faster it scrolls.";
"mode.constant.detail" = "Same multiplier for the whole drag - the behaviour of earlier versions.";
"mode.velocity.detail" = "Response and Boost are the two knobs most people touch. Everything else refines how the speed is measured and how far it is allowed to go.";
"mode.distance.detail" = "Good when you want a steady, predictable feel: the scroll depends only on how far you dragged, not on how fast your hand moved.";

"speed.title" = "Speed";
"speed.base" = "Base speed";
"speed.baseHint" = "The speed at a normal, unhurried drag. The dynamic modes multiply this.";
"speed.constantNote" = "Constant mode always uses the base speed; the coefficients below belong to the two dynamic modes.";

"coef.velocity.title" = "Coefficients — Follow the hand";
"coef.response" = "Response";
"coef.response.hint" = "How strongly the speed follows the hand (k_v). 0 keeps the base speed, 2 reacts twice as much.";
"coef.boost" = "Boost while accelerating";
"coef.boost.hint" = "Extra speed while the hand speeds up (k_a), taken from the change of the pointer speed. Slowing down never reduces the scroll.";
"coef.vref" = "Reference speed";
"coef.vref.hint" = "The pointer speed treated as normal, in pixels per second. Lower makes the mode react earlier.";
"coef.aref" = "Reference acceleration";
"coef.aref.hint" = "The acceleration that earns the full boost, in pixels per second squared.";
"coef.vexp" = "Curve exponent";
"coef.vexp.hint" = "1 is a straight line; below 1 reacts earlier, above 1 waits for faster movement.";
"coef.smooth" = "Smoothing";
"coef.smooth.hint" = "How quickly the multiplier follows changes. Low is calm, 1 follows every step.";
"coef.min" = "Min multiplier";
"coef.min.hint" = "Never scroll slower than this, whatever the hand does.";
"coef.max" = "Max multiplier";
"coef.max.hint" = "The ceiling, so a fast flick cannot fly off.";

"coef.distance.title" = "Coefficients — Progressive";
"coef.ramp" = "Ramp";
"coef.ramp.hint" = "How much faster it gets on a long drag. 0 keeps the base speed.";
"coef.dref" = "Ramp distance";
"coef.dref.hint" = "The distance from where you pressed at which the ramp is at full strength.";
"coef.dexp" = "Curve exponent";
"coef.dexp.hint" = "1 grows steadily; below 1 speeds up early, above 1 stays calm at first.";
"coef.dsmooth.hint" = "How quickly the multiplier follows the distance.";
"coef.dmax.hint" = "The ceiling for the ramp.";

"presets.title" = "Presets";
"presets.gentle" = "Gentle";
"presets.balanced" = "Balanced";
"presets.aggressive" = "Aggressive";
"presets.defaults" = "Defaults";
"presets.hint" = "Gentle reacts softly, Aggressive follows the hand much more. Defaults resets this tab (speed mode, coefficients and inertia) and leaves the General tab alone.";

"live.title" = "Live";
"live.placeholder" = "no data yet";
"live.footer" = "Pointer speed, its change and the multiplier that was actually used on the last scroll step - handy while tuning the coefficients.";
"live.format" = "pointer %.0f px/s   change %+.0f px/s²   multiplier %.2f×";

"inertia.title" = "Inertia";
"inertia.enabled" = "Keep scrolling after release";
"inertia.hint" = "Inertia is independent from the speed mode: it has its own strength and thresholds below.";
"inertia.friction" = "Friction";
"inertia.friction.hint" = "Lower makes the scroll settle sooner.";
"inertia.start" = "Start threshold";
"inertia.start.hint" = "The pointer speed at release that starts inertia.";
"inertia.stop" = "Stop threshold";
"inertia.stop.hint" = "Inertia stops once it slows below this.";
"inertia.window" = "Velocity window";
"inertia.window.hint" = "How far back the release speed is measured. Shorter feels more immediate.";
"inertia.follows" = "Coast follows the speed mode";
"inertia.follows.on" = "Inertia starts from the speed you felt, including the dynamic boost.";
"inertia.follows.off" = "Inertia starts from the base speed only, whatever mode is selected.";

