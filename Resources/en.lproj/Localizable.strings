"cursor.title" = "Cursor";
"cursor.hand" = "Change cursor (open hand)";
"cursor.freeze" = "Do not move the pointer while dragging";
"cursor.skipScrollbars" = "Ignore presses on scroll bars";
"cursor.dragThreshold" = "Drag threshold";
