"general.enabled" = "DirectScroll enabled";
"general.controlType" = "Control type:";
"general.controlTypeHint" = "Hold this button and drag to scroll the window under the pointer. With an extra button (Button 4 and up) a short press does nothing, so the button keeps no other action.";
"general.activateOn" = "Activate on:";
"general.disableOn" = "Disable on:";
